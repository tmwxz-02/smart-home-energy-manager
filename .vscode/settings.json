{
  // Testing panel (flask icon) finds the tests in tests/.
  "python.testing.unittestEnabled": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestArgs": ["-v", "-s", "tests", "-t", ".", "-p", "test_*.py"],

  // Hide Python cache folders from the file tree.
  "files.exclude": {
    "**/__pycache__": true
  },
  "files.encoding": "utf8",
  "editor.tabSize": 4,
  "[javascript]": { "editor.tabSize": 2 },
  "[html]": { "editor.tabSize": 2 },
  "[css]": { "editor.tabSize": 2 }
}
